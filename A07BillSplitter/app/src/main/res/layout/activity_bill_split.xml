<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".BillSplitActivity">

    <TextView
        android:id="@+id/txt_number_of_people"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="参加者は4人" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_total_amount"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="支払額（￥）" />

        <EditText
            android:id="@+id/edt_total_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="金額を入力してください"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="9"
            tools:text="1234567890" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_calc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="計算実行" />

    <TextView
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="計算結果" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_participant_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="鈴木一郎: ￥411\n鈴木二郎: ￥411\n鈴木三郎: ￥412\n合計: ￥1234" />
    </ScrollView>
</LinearLayout>