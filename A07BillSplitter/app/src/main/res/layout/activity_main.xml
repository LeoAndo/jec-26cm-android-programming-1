<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/title_img" />

    <EditText
        android:id="@+id/edt_participant_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="参加者の名前を入力してください"
        android:importantForAutofill="no"
        android:inputType="textPersonName" />

    <Button
        android:id="@+id/btn_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="登録" />

    <Button
        android:id="@+id/btn_bill_split"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ワリカン画面へ" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="参加者一覧" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_participant_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="鈴木一郎\n鈴木二郎\n鈴木三郎" />
    </ScrollView>
</LinearLayout>